# ---- user data: profile, API keys, chat history, backups — NEVER commit
/data/
*.db
*.db-*
*.db.*
*.sqlite
*.sqlite3

# ---- large downloaded assets (fetched by setup.sh / the in-app wizard)
/models/
/vendor/

# ---- python
.venv/
__pycache__/
*.pyc

# ---- personal notes & local tool state
/ABOUT-KAIWA.txt
/.claude/
/CLAUDE.md

# ---- OS / misc
.DS_Store
*.log
/work/
/tests/e2e/artifacts/

# Production settings and Cloudflare connector credentials stay outside Git.
.env
.env.*
!.env.example
/.secrets/
