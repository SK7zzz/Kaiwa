# Production refuses to start unless the four Access settings are present.
KAIWA_PUBLIC_ORIGIN=https://kaiwa.adonain.dev
KAIWA_ACCESS_TEAM_DOMAIN=replace-with-team.cloudflareaccess.com
KAIWA_ACCESS_AUD=replace-with-access-application-audience
KAIWA_ALLOWED_EMAIL=you@example.com
# Use version + sha256 digest inspected on the deployment machine.
KAIWA_VOICEVOX_IMAGE=voicevox/voicevox_engine@sha256:4a9f0f5b3d3ed7438975f2b277cdfb805c6f8d5ed5d7258ac2988abbeae032a0
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
KAIWA_TUNNEL_TOKEN_FILE=.secrets/tunnel-token
KAIWA_IMAGE_TAG=local
