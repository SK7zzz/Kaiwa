# Tailscale Serve on the host terminates HTTPS and injects the user identity.
KAIWA_PUBLIC_ORIGIN=https://rushia-1.tail7bb611.ts.net
KAIWA_AUTH_PROVIDER=tailscale
KAIWA_TAILSCALE_LOGIN=adonain.dev@gmail.com
# Use version + sha256 digest inspected on the deployment machine.
KAIWA_VOICEVOX_IMAGE=voicevox/voicevox_engine@sha256:4a9f0f5b3d3ed7438975f2b277cdfb805c6f8d5ed5d7258ac2988abbeae032a0
KAIWA_PROXY_IMAGE=nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
# Generate these private host files with deploy/render-tailscale-proxy.py.
KAIWA_PROXY_CONFIG_FILE=/etc/kaiwa/tailscale/proxy.conf
KAIWA_PROXY_SECRET_FILE=/etc/kaiwa/tailscale/proxy-secret
KAIWA_IMAGE_TAG=local
