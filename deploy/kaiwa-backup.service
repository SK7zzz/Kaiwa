[Unit]
Description=Copia consistente de la base personal de Kaiwa
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=KAIWA_DOCKER_HOST=unix:///var/run/docker.sock
ExecStart=/usr/local/libexec/kaiwa-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
